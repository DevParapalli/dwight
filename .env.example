GROQ_ENV_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Tried in order after GROQ_MODEL, before the local model. A hosted tier runs out
# of budget per model rather than per account, so a second and third hosted model
# buy real headroom before anything has to move on-device. Must be ids the
# account actually serves.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Groq's limits are set by the account tier, not by preference: a request whose
# expected output exceeds the org's output-tokens-per-minute cap is rejected
# outright ("request too large") and no retry fixes it. These suit a 1000 OTPM
# tier; raising them needs a tier upgrade.
LLM_MAX_OUTPUT_TOKENS=900
LLM_VALUE_BATCH_SIZE=15

# No-key fallback: llama.cpp's llama-server running qwen3-8b (Q4_K_M) locally.
# Leave LOCAL_FALLBACK_MODEL blank to use the deterministic-only fallback instead.
LOCAL_FALLBACK_MODEL=qwen3-8b
LOCAL_FALLBACK_URL=http://localhost:8080/v1
# Local inference isn't metered, so these are generous. max_tokens is a ceiling,
# not a reservation -- headroom you don't use costs nothing.
LOCAL_MAX_OUTPUT_TOKENS=8192
LOCAL_VALUE_BATCH_SIZE=50
# Reasoning models spend the output budget thinking before answering. qwen3-8b
# burned 4096 tokens on 16k characters of reasoning and still returned nothing;
# with thinking off the same call answers in 336 tokens. Raising the budget does
# not fix it -- turning thinking off does.
LOCAL_DISABLE_THINKING=true
DB_PATH=data/dwight.db

# Testing only. Registers POST /nuke, which empties every table in this app's
# database and asks the target to empty its own. Leave unset outside testing --
# when it is unset the route does not exist.
ENABLE_NUKE=false
